#CONFIGURATION FILE

# need for naming log file, trnsactions, payment requests, etc
PLUGIN_ID=dectacy_payments_pmg

# name which will be available in WooCommerce/Settings/Payments
PLUGIN_NAME=Decta Payments Gateway

# name for naming some additional packages, files, etc
PLUGIN_SHORT_NAME=dectacy_payments_gateway

# Shortname which will be avaliable customers near button "Pay" and as short description for module in "Modules"
PLUGIN_SHORTINFO=Pay with card

# description which will be available in WooCommerce/Settings/Payments
PLUGIN_DESCRIPTION=DECTA can be easily integrated into the billing process of e-commerce websites and mobile apps. If your online store is using WooCommerce, download and set up this ready-made plugin.<br>

# notification about DMS transaction
MESSAGE_DMS=The payment is successful. Payment status is "Hold"! Please capture/void payment in your payment gateway personal %cabinet%!

# notification about success transaction
MESSAGE_SUCCESS_TRANSACTION=Payment successful!

# enable/disable client notifications via email
SEND_TO_EMAIL=true

# module version
PAYMENTS_MODULE_VERSION=v3.11

# The author of the plugin
AUTHOR=Decta

# gate for payment which will be used
GATE=https://gate.cy.decta.com
# url for web_sdk pay_form script
WEB_SDK_URL=https://payments.cy.decta.com/sdk/sdk.min.js

# CONFIGURATION FOR AUTO-UPDATES
# url with data about last stable version of plugin
#PLUGIN_UPDATE_CHECKER_URL=https://some.site/payment_pmg.json
# short info about new release
PLUGIN_WHATS_NEW=New stable version of our module. We added auto update, fixed some bugs, rewrite plugin.
# path with zip arthive with new plugin
#PLUGIN_PACKAGE_URL=https://some.site

# version on API for make payment via GATE
PAYMENT_API_VERSION=v0.6

# MINIMAL PARAMETERS FOR PLUGIN
# minimal available version on https://wordpress.org/plugins/woocommerce/advanced/
WOOCOMMERCE_VERSION_MIN=3.0.0
PHP_VERSION_MIN=7.0
# Last pushed 6 years ago
WORDPRESS_VERSION_MIN=4.6.1
#END CONFIG
